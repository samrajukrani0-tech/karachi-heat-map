{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "features.json",
  "type": "object",
  "required": ["schema_version", "features"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"type": "string"},
    "generated": {"type": "string"},
    "note": {"type": "string"},
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "phase", "title", "acceptance", "depends_on", "passes",
                     "blocked_on", "dropped", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^P[0-6]-[0-9]{2}[a-z]?$"},
          "phase": {"type": "integer", "minimum": 0, "maximum": 6},
          "title": {"type": "string", "minLength": 3},
          "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "depends_on": {"type": "array", "items": {"type": "string"}},
          "passes": {"type": "boolean"},
          "blocked_on": {"type": ["string", "null"]},
          "dropped": {"type": ["string", "null"]},
          "evidence": {"type": ["string", "null"]}
        }
      }
    }
  }
}
